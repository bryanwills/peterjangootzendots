profile desktop {
	output eDP-1 disable
	output DP-1 enable mode 3840x2160 position 2952,0 scale 1.3 transform 270
	output DP-2 enable mode 3840x2160 position 0,400 scale 1.3

	exec swaymsg focus output DP-2
	exec ~/.azotebg
}

profile laptop {
	output eDP-1 enable mode 1920x1080 position 0,0 scale 1.0

	exec swaymsg focus output eDP-1
	exec ~/.laptopbg
}
